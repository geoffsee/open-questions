	"scripts": {
		"dev": "vike dev",
		"build": "vike build",
		"build:cli": "bun build --compile scripts/publish-cli.ts --outfile dist/publish-cli",
		"build:full": "bun run fetch-data && bun run fetch-news && bun run fetch-cases && bun run enrich-data && bun run build",
		"fetch-data": "bun scripts/fetch-data.ts",
		"fetch-news": "bun scripts/fetch-news.ts",
		"fetch-cases": "bun scripts/fetch-cases.ts",
		"enrich-data": "bun scripts/enrich-data.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"preview": "vike build && vike preview",
		"start": "bun server.ts",
		"prod": "vike build && bun run start"
	},
	"dependencies": {
		"@universal-middleware/core": "^0.4.18",
		"@vikejs/h3": "^0.2.1",
		"h3": "~1.15.11",
		"marked": "^18.0.12",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"telefunc": "^0.2.24",
